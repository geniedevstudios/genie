# Existing email delivery settings
RESEND_API_KEY=
EMAIL_USER=geniedev.noreply@gmail.com

# Create a Managed Turnstile widget for your site's hostnames.
# Set the public key BEFORE building: Next.js embeds it in the browser bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=geniedevstudios.com,www.geniedevstudios.com

# Required on Vercel, including preview deployments. Use a separate database
# for previews if you do not want them to share the production rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development: use a development widget allowing localhost and set
# TURNSTILE_ALLOWED_HOSTNAMES=localhost (also allow 127.0.0.1 if used).
# Local npm run dev uses an in-memory rate limit when Redis is unconfigured.
